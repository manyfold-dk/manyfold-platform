<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions shared by the repository's Java applications. An application adds its
     own file through the manyfold.spotbugs.excludes property. -->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
  <!-- Generated code (Quarkus, Panache) -->
  <Match>
    <Source name="~.*_\$\w+\.java"/>
  </Match>
  <!-- Test classes may keep fields they do not read -->
  <Match>
    <Class name="~.*Test"/>
    <Bug pattern="URF_UNREAD_FIELD"/>
  </Match>
  <!-- Nothing here is Java-serialized -->
  <Match>
    <Bug pattern="SE_NO_SERIALVERSIONID"/>
  </Match>
</FindBugsFilter>
