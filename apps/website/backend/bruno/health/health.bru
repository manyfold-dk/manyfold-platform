meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/q/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should be healthy", function() {
    expect(res.body.status).to.equal("UP");
  });
}
