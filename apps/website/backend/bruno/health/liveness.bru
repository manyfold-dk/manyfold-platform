meta {
  name: Liveness Probe
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/q/health/live
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should be live", function() {
    expect(res.body.status).to.equal("UP");
  });
}
