meta {
  name: OpenAPI Spec (YAML)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/q/openapi
  body: none
  auth: none
}

headers {
  Accept: application/yaml
}

assert {
  res.status: eq 200
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should contain openapi version", function() {
    expect(res.body).to.contain("openapi:");
  });
}
