<?xml version="1.0" encoding="UTF-8"?>
<!-- The website's own SpotBugs exclusions; the shared ones are in build/lint/. -->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">




  <!-- Allow REST methods to return null (handled by framework) -->
  <Match>
    <Package name="~dk\.manyfold\.website\.api\..*"/>
    <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS"/>
  </Match>

  <!-- Java records expose their fields by design (DTOs) -->
  <Match>
    <Package name="~dk\.manyfold\.website\.api\.v1\.model"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- Health client records expose their fields by design -->
  <Match>
    <Package name="~dk\.manyfold\.website\.health"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- Health clients intentionally catch broad exceptions for resilience -->
  <Match>
    <Package name="~dk\.manyfold\.website\.health"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!-- Deep health endpoint catches broad exceptions for CPU estimation -->
  <Match>
    <Class name="dk.manyfold.website.api.v1.DeepHealthResource"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!-- CDI-injected fields are managed by the container -->
  <Match>
    <Class name="~dk\.manyfold\.website\.metrics\..*"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

</FindBugsFilter>
