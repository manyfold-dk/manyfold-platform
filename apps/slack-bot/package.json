{
  "name": "slack-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "@slack/socket-mode": "^2.0.3",
    "@slack/types": "^2.19.0",
    "ioredis": "^5.9.2",
    "node-cron": "^4.2.1",
    "pino": "^10.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
