apiVersion: v1
kind: ResourceQuota
metadata:
  name: {{TENANT}}-quota
  namespace: {{TENANT}}-prod
  labels:
    manyfold.dk/tenant: {{TENANT}}
spec:
  hard:
    requests.cpu: "2"
    requests.memory: 4Gi
    limits.cpu: "4"
    limits.memory: 8Gi
    persistentvolumeclaims: "8"
    requests.storage: 20Gi
    pods: "30"
    # Deny tenant-provisioned LoadBalancers (Hetzner LB cost) and NodePorts (host
    # port exposure). Tenants expose via the shared Gateway path instead.
    services.loadbalancers: "0"
    services.nodeports: "0"
---
apiVersion: v1
kind: LimitRange
metadata:
  name: {{TENANT}}-limits
  namespace: {{TENANT}}-prod
  labels:
    manyfold.dk/tenant: {{TENANT}}
spec:
  limits:
    - type: Container
      default:
        cpu: 250m
        memory: 256Mi
      defaultRequest:
        cpu: 50m
        memory: 64Mi
---
apiVersion: v1
kind: ResourceQuota
